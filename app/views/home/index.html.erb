<h1>Home Page</h1>

<h2>Books</h2>

<% @books.each do |book| %>
  <h3><%= book.title %></h3>
  <p><b>Author:</b> <%= book.author %></p>
  <p><b>Price:</b> <%= book.price %></b></p>
  <p><b>Published Date:</b> <%= book.published_date %></p>
  <p>
    <%= link_to("Details", show_detail_path(book), class: 'action show') %> | 
    <%= link_to("Edit", edit_update_book_path(book), class: 'action edit') %> |
    <%= link_to("Delete", delete_delete_book_path(book), class: 'action delete') %>
  </p>
<% end %>
<%= link_to("Add a Book", new_add_book_path, class: 'action new') %>

<% if flash[:notice] %>
  <div class="notice"><%= flash[:notice] %></div>
  <% flash.discard(:notice) %>
<% end %>